NODE_ENV=development
PORT=3000
HOST=0.0.0.0
API_VERSION=v1

CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
# Set this when the frontend and API are hosted on different origins.
# PUBLIC_API_URL=https://api.example.com
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
PASSWORD_RESET_REDIRECT_URL=http://localhost:3000/reset-password

DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres
DB_SSL=true

REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false

# Optional Prisma/MySQL example
MYSQL_DATABASE_URL=mysql://user:password@localhost:3306/example_db

# Optional Groq AI integration
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b

# Paystack recurring subscriptions (create monthly plans in the Paystack dashboard)
PAYSTACK_SECRET_KEY=your-paystack-secret-key
PAYSTACK_PREMIUM_PLAN_CODE=PLN_premium_monthly
PAYSTACK_INSTALLER_PLAN_CODE=PLN_installer_monthly
PAYSTACK_CURRENCY=USD
PAYSTACK_CALLBACK_URL=http://localhost:3000/billing
